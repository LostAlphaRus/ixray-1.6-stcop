[general]
Platform = soc ; Platform mode. Supported values: cop (Call of Pripyat), cs (Clear Sky), soc (Shadow of Chernobyl)
title = st_ixray_title ; Mod name
SaveImageSize = 128, 128

[shaders_options]
USE_LEGACY_LIGHT = 1
USE_SOC_LIGHTING = 1

; Hozar: For PBS pipeline
; IBL_FAKE_IRRADANCE = 1
; IBL_REMAP_IRRADANCE = 1
; IBL_REMAP_REFLECTIONS = 1
; IBL_REMAP_POSITIVE_Y = 1
; IBL_MAX_LOD = 10
; USE_FULL_SKY_SPHERE = 1

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Engine features

[ui]
HQIcons = false
WeaponIconScale = 0.9 ; Scale factor for static_wpn_icon in maingame.xml. For CoP it's 0.8, for CS - 0.65, for SoC - 0.9
ShowLoadingStages = true ; Loading stages from CS/SoC

[physics]
DeadBodyRagdoll = false

[gameplay]
UseNewScopeSystem = false ; Использование scopes.xml из ЗП

[render]
DisableLoadScreenTips = true
FontAtlasSize = 4096
